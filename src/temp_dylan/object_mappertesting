#!/usr/bin/env python3
# Detect red hotspots; build a small local cloud in camera frame (from a registered
# cloud OR back-projected aligned depth), transform to a global frame, publish the
# cloud, and print the global centroid once per hotspot.

import math, time, struct
import numpy as np
import cv2

import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data, QoSProfile, ReliabilityPolicy, DurabilityPolicy, HistoryPolicy
from rclpy.time import Time as RclpyTime
from rclpy.duration import Duration

from cv_bridge import CvBridge
from sensor_msgs.msg import Image, CameraInfo, PointCloud2, PointField
from geometry_msgs.msg import PointStamped, PoseArray, Pose
from visualization_msgs.msg import Marker

import tf2_ros
from tf2_ros import TransformException

from typing import Union
from builtin_interfaces.msg import Time as RosMsgTime

# message_filters
from message_filters import Subscriber, ApproximateTimeSynchronizer

# ---------- helpers ----------
def fmt_stamp(t: Union[RclpyTime, RosMsgTime]) -> str:
    if isinstance(t, RclpyTime):
        ns = int(t.nanoseconds); return f"{ns//10**9}.{ns%10**9:09d}"
    return f"{int(t.sec)}.{int(t.nanosec):09d}"

def quat_to_R(qx, qy, qz, qw):
    xx, yy, zz = qx*qx, qy*qy, qz*qz
    xy, xz, yz = qx*qy, qx*qz, qy*qz
    wx, wy, wz = qw*qx, qw*qy, qw*qz
    return np.array([
        [1-2*(yy+zz), 2*(xy-wz),   2*(xz+wy)],
        [2*(xy+wz),   1-2*(xx+zz), 2*(yz-wx)],
        [2*(xz-wy),   2*(yz+wx),   1-2*(xx+yy)]
    ], float)

def make_cloud(points_xyz: np.ndarray, frame_id: str, stamp: RclpyTime) -> PointCloud2:
    msg = PointCloud2()
    msg.header.frame_id = frame_id
    msg.header.stamp = stamp.to_msg()
    msg.height = 1
    pts = np.asarray(points_xyz, dtype=np.float32) if points_xyz.size else np.empty((0,3), np.float32)
    msg.width = int(pts.shape[0])
    msg.fields = [
        PointField(name='x', offset=0,  datatype=PointField.FLOAT32, count=1),
        PointField(name='y', offset=4,  datatype=PointField.FLOAT32, count=1),
        PointField(name='z', offset=8,  datatype=PointField.FLOAT32, count=1),
    ]
    msg.is_bigendian = False
    msg.point_step   = 12
    msg.row_step     = msg.point_step * msg.width
    msg.is_dense     = True
    msg.data         = pts.tobytes()
    return msg

# ---------- node ----------
class ObjectMapper(Node):
    def __init__(self):
        super().__init__('object_mapper')

        # ---- params ----
        self.declare_parameter('target_frame', 'world')
        self.declare_parameter('debug_view', True)
        self.declare_parameter('archive_radius_m', 0.60)

        # topics
        self.declare_parameter('image_topic', '/camera/image')
        self.declare_parameter('registered_cloud_topic', '/camera/depth_registered/points')
        self.declare_parameter('aligned_depth_topic', '/camera/aligned_depth_to_color/image')
        self.declare_parameter('camera_info_topic', '/camera/camera_info')

        # choose data path
        self.declare_parameter('use_registered_cloud', True)

        # segmentation & cloud sampling
        self.declare_parameter('min_area_px', 40)
        self.declare_parameter('cloud_stride_px', 2)
        self.declare_parameter('cloud_max_points', 800)
        self.declare_parameter('roi_shrink_px', 0)

        # sync & TF
        self.declare_parameter('sync_slop_sec', 0.15)
        self.declare_parameter('tf_wait_sec', 0.06)

        # get params
        self.target_f    = str(self.get_parameter('target_frame').value)
        self.debug_view  = bool(self.get_parameter('debug_view').value)
        self.archive_r   = float(self.get_parameter('archive_radius_m').value)

        self.image_topic = str(self.get_parameter('image_topic').value)
        self.reg_cloud_topic = str(self.get_parameter('registered_cloud_topic').value)
        self.depth_topic = str(self.get_parameter('aligned_depth_topic').value)
        self.caminfo_topic = str(self.get_parameter('camera_info_topic').value)

        self.use_reg_cloud = bool(self.get_parameter('use_registered_cloud').value)

        self.min_area  = int(self.get_parameter('min_area_px').value)
        self.stride    = max(1, int(self.get_parameter('cloud_stride_px').value))
        self.cloud_cap = int(self.get_parameter('cloud_max_points').value)
        self.roi_shrink = max(0, int(self.get_parameter('roi_shrink_px').value))

        self.sync_slop = float(self.get_parameter('sync_slop_sec').value)
        self.tf_wait   = float(self.get_parameter('tf_wait_sec').value)

        # ---- pubs ----
        self.pub_point   = self.create_publisher(PointStamped, '/detected_objects', 10)
        self.pub_marker  = self.create_publisher(Marker, '/marker', 10)
        self.pub_archive = self.create_publisher(
            PoseArray, '/hotspots/archive',
            QoSProfile(history=HistoryPolicy.KEEP_LAST, depth=1,
                       reliability=ReliabilityPolicy.RELIABLE,
                       durability=DurabilityPolicy.TRANSIENT_LOCAL)
        )
        self.pub_hotspot_cloud = self.create_publisher(
            PointCloud2, '/hotspot/cloud',
            QoSProfile(history=HistoryPolicy.KEEP_LAST, depth=1,
                       reliability=ReliabilityPolicy.BEST_EFFORT,
                       durability=DurabilityPolicy.TRANSIENT_LOCAL)
        )

        self.archive = PoseArray(); self.archive.header.frame_id = self.target_f

        # ---- TF ----
        self.tfbuf = tf2_ros.Buffer(cache_time=rclpy.duration.Duration(seconds=10.0))
        self.tfl   = tf2_ros.TransformListener(self.tfbuf, self)
        self._last_tf_warn = 0.0

        # ---- I/O & sync ----
        self.bridge = CvBridge()
        if self.use_reg_cloud:
            self.img_sub   = Subscriber(self, Image, self.image_topic, qos_profile=qos_profile_sensor_data)
            self.cloud_sub = Subscriber(self, PointCloud2, self.reg_cloud_topic, qos_profile=qos_profile_sensor_data)
            self.sync = ApproximateTimeSynchronizer([self.img_sub, self.cloud_sub], queue_size=10, slop=self.sync_slop)
            self.sync.registerCallback(self._cb_with_cloud)
            mode = "registered cloud"
        else:
            self.img_sub   = Subscriber(self, Image, self.image_topic, qos_profile=qos_profile_sensor_data)
            self.depth_sub = Subscriber(self, Image, self.depth_topic, qos_profile=qos_profile_sensor_data)
            self.info_sub  = Subscriber(self, CameraInfo, self.caminfo_topic, qos_profile=qos_profile_sensor_data)
            self.sync = ApproximateTimeSynchronizer([self.img_sub, self.depth_sub, self.info_sub], queue_size=10, slop=self.sync_slop)
            self.sync.registerCallback(self._cb_with_depth)
            mode = "aligned depth + camera_info"

        # debug throttle
        self._last_dbg = 0.0; self._dbg_hz = 5.0

        self.get_logger().info(f'ObjectMapper ready. target_frame={self.target_f} ({mode})')

    # ---------- common: segmentation ----------
    def _segment_red(self, bgr):
        rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)
        hsv = cv2.cvtColor(bgr, cv2.COLOR_BGR2HSV)
        red1 = cv2.inRange(hsv, np.array([0,   60, 60], np.uint8), np.array([10, 255, 255], np.uint8))
        red2 = cv2.inRange(hsv, np.array([170, 60, 60], np.uint8), np.array([179, 255, 255], np.uint8))
        mask_hsv = cv2.bitwise_or(red1, red2)
        b,g,r = cv2.split(bgr); rg_max = cv2.max(b,g)
        rd = ((r.astype(np.int16) - rg_max.astype(np.int16)) > 40) & (r > 120)
        mask = cv2.bitwise_or(mask_hsv, (rd.astype(np.uint8) * 255))
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN,  np.ones((3,3), np.uint8))
        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((5,5), np.uint8))
        return rgb, mask

    def _roi_from_mask(self, mask, contour):
        x, y, w, h = cv2.boundingRect(contour)
        if self.roi_shrink > 0:
            s = self.roi_shrink
            x = max(0, x + s); y = max(0, y + s)
            w = max(1, w - 2*s); h = max(1, h - 2*s)
        H, W = mask.shape[:2]
        return x, y, min(W, x+w), min(H, y+h)

    # ---------- mode 1: registered cloud ----------
    def _cb_with_cloud(self, img_msg: Image, cloud_msg: PointCloud2):
        bgr = self.bridge.imgmsg_to_cv2(img_msg, desired_encoding='bgr8')
        rgb, mask = self._segment_red(bgr)

        cnts, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        if not cnts: self._show_debug(rgb, mask, None); return
        c = max(cnts, key=cv2.contourArea)
        if cv2.contourArea(c) < self.min_area: self._show_debug(rgb, mask, None); return

        M = cv2.moments(c); 
        if M['m00'] == 0: self._show_debug(rgb, mask, None); return
        cx, cy = int(M['m10']/M['m00']), int(M['m01']/M['m00'])

        x1,y1,x2,y2 = self._roi_from_mask(mask, c)
        pts_cam = []
        for v in range(y1, y2, self.stride):
            row = mask[v]
            for u in range(x1, x2, self.stride):
                if row[u] == 0: continue
                xyz = self._xyz_from_cloud(cloud_msg, u, v)
                if xyz is not None and np.all(np.isfinite(xyz)):
                    pts_cam.append(xyz)
                    if len(pts_cam) >= self.cloud_cap: break
            if len(pts_cam) >= self.cloud_cap: break
        if not pts_cam: self._show_debug(rgb, mask, (cx,cy)); return

        pts_cam = np.asarray(pts_cam, float)
        cloud_t = RclpyTime.from_msg(cloud_msg.header.stamp)
        src_f   = cloud_msg.header.frame_id
        self._publish_world_outputs(pts_cam, src_f, cloud_t, rgb, mask, (cx,cy))

    # ---------- mode 2: aligned depth image ----------
    def _cb_with_depth(self, img_msg: Image, depth_msg: Image, info_msg: CameraInfo):
        bgr = self.bridge.imgmsg_to_cv2(img_msg, desired_encoding='bgr8')
        depth = self.bridge.imgmsg_to_cv2(depth_msg, desired_encoding='passthrough')  # meters
        rgb, mask = self._segment_red(bgr)

        cnts, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        if not cnts: self._show_debug(rgb, mask, None); return
        c = max(cnts, key=cv2.contourArea)
        if cv2.contourArea(c) < self.min_area: self._show_debug(rgb, mask, None); return

        M = cv2.moments(c); 
        if M['m00'] == 0: self._show_debug(rgb, mask, None); return
        cx, cy = int(M['m10']/M['m00']), int(M['m01']/M['m00'])

        x1,y1,x2,y2 = self._roi_from_mask(mask, c)
        K = np.array(info_msg.k).reshape(3,3)
        fx, fy, cx0, cy0 = K[0,0], K[1,1], K[0,2], K[1,2]

        pts_cam = []
        for v in range(y1, y2, self.stride):
            for u in range(x1, x2, self.stride):
                if mask[v, u] == 0: continue
                Z = float(depth[v, u])
                if not math.isfinite(Z) or Z <= 0.0: continue
                X = (u - cx0) * Z / fx
                Y = (v - cy0) * Z / fy
                pts_cam.append([X, Y, Z])
                if len(pts_cam) >= self.cloud_cap: break
            if len(pts_cam) >= self.cloud_cap: break
        if not pts_cam: self._show_debug(rgb, mask, (cx,cy)); return

        pts_cam = np.asarray(pts_cam, float)
        depth_t = RclpyTime.from_msg(depth_msg.header.stamp)
        src_f   = depth_msg.header.frame_id  # should be RGB optical frame when aligned
        self._publish_world_outputs(pts_cam, src_f, depth_t, rgb, mask, (cx,cy))

    # ---------- common publishing ----------
    def _publish_world_outputs(self, pts_cam: np.ndarray, src_frame: str, stamp: RclpyTime,
                               rgb_img, mask_img, center_xy):
        # TF at stamp, fallback to latest
        if not self.tfbuf.can_transform(self.target_f, src_frame, stamp, timeout=Duration(seconds=self.tf_wait)):
            if not self.tfbuf.can_transform(self.target_f, src_frame, RclpyTime(), timeout=Duration(seconds=self.tf_wait)):
                nowm = time.monotonic()
                if nowm - self._last_tf_warn > 1.0:
                    self.get_logger().warn(f"No TF {self.target_f}�{src_frame} at {fmt_stamp(stamp)} or latest; skipping.")
                    self._last_tf_warn = nowm
                self._show_debug(rgb_img, mask_img, center_xy); return
            tfm = self.tfbuf.lookup_transform(self.target_f, src_frame, RclpyTime())
        else:
            tfm = self.tfbuf.lookup_transform(self.target_f, src_frame, stamp)

        t = tfm.transform.translation
        q = tfm.transform.rotation
        R = quat_to_R(q.x, q.y, q.z, q.w)
        T = np.eye(4); T[:3,:3] = R; T[:3, 3] = np.array([t.x, t.y, t.z])

        pts_h = np.c_[pts_cam, np.ones((pts_cam.shape[0], 1))]
        pts_world = (T @ pts_h.T).T[:, :3]
        centroid = pts_world.mean(axis=0)

        # Publish cloud (latched), centroid, marker
        self.pub_hotspot_cloud.publish(make_cloud(pts_world, self.target_f, stamp))

        pt_out = PointStamped()
        pt_out.header.frame_id = self.target_f
        pt_out.header.stamp = stamp.to_msg()
        pt_out.point.x, pt_out.point.y, pt_out.point.z = [float(v) for v in centroid]
        self.pub_point.publish(pt_out)
        self._publish_marker(pt_out)

        if self._record_if_new(pt_out):
            self.get_logger().info(f"Hotspot @ {self.target_f}: ({pt_out.point.x:.2f}, {pt_out.point.y:.2f}, {pt_out.point.z:.2f})")
            self.pub_archive.publish(self.archive)

        self._show_debug(rgb_img, mask_img, center_xy)

    # ---------- utilities ----------
    def _xyz_from_cloud(self, cloud: PointCloud2, u: int, v: int):
        # Index an organized PointCloud2 (registered cloud is organized)
        if cloud.width == 0 or cloud.height == 0: return None
        if not (0 <= u < cloud.width and 0 <= v < cloud.height): return None
        idx = v * cloud.row_step + u * cloud.point_step
        offs = {f.name: f.offset for f in cloud.fields}
        if not all(k in offs for k in ('x','y','z')): return None
        endian = '>' if cloud.is_bigendian else '<'
        try:
            x = struct.unpack_from(endian+'f', cloud.data, idx + offs['x'])[0]
            y = struct.unpack_from(endian+'f', cloud.data, idx + offs['y'])[0]
            z = struct.unpack_from(endian+'f', cloud.data, idx + offs['z'])[0]
        except Exception:
            return None
        if not (math.isfinite(x) and math.isfinite(y) and math.isfinite(z)): return None
        if (x==0 and y==0 and z==0): return None
        return np.array([x,y,z], float)

    def _publish_marker(self, pt: PointStamped):
        mk = Marker()
        mk.header.frame_id = pt.header.frame_id
        mk.header.stamp = self.get_clock().now().to_msg()
        mk.ns = 'hotspots'; mk.id = 0
        mk.type = Marker.SPHERE; mk.action = Marker.ADD
        mk.pose.position.x = pt.point.x
        mk.pose.position.y = pt.point.y
        mk.pose.position.z = pt.point.z
        mk.pose.orientation.w = 1.0
        mk.scale.x = mk.scale.y = mk.scale.z = 0.4
        mk.color.r, mk.color.g, mk.color.b, mk.color.a = 0.2, 0.8, 1.0, 0.9
        self.pub_marker.publish(mk)

    def _show_debug(self, rgb, mask, center):
        if not self.debug_view: return
        now = time.monotonic()
        if now - getattr(self, "_last_dbg", 0.0) < 1.0 / 5.0: return
        self._last_dbg = now
        dbg = rgb.copy()
        if center is not None:
            cv2.circle(dbg, center, 8, (0,255,0), 2)
        cv2.imshow('Camera Feed + Hotspot', cv2.cvtColor(dbg, cv2.COLOR_RGB2BGR))
        cv2.imshow('Hotspot mask', mask)
        cv2.waitKey(1)

    def _record_if_new(self, pt: PointStamped) -> bool:
        if self.archive.header.frame_id != self.target_f:
            self.archive.header.frame_id = self.target_f
        p = np.array([pt.point.x, pt.point.y, pt.point.z])
        for pose in self.archive.poses:
            q = np.array([pose.position.x, pose.position.y, pose.position.z])
            if np.linalg.norm(p-q) < self.archive_r:
                return False
        pose = Pose()
        pose.position.x, pose.position.y, pose.position.z = p.tolist()
        pose.orientation.w = 1.0
        self.archive.poses.append(pose)
        self.archive.header.stamp = self.get_clock().now().to_msg()
        return True

# ---------- main ----------
def main():
    rclpy.init()
    node = ObjectMapper()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
